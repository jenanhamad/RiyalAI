# انسخ إلى local/.env — لا تضع مفاتيح حقيقية هنا
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_RECEIPT_MODEL=google/gemini-2.5-flash-lite
# OPENROUTER_TRANSCRIPTION_MODEL=google/gemini-2.0-flash-001  # اختياري — الصوت
JWT_SECRET=change-this-to-any-random-string
LOCAL_API_URL=http://localhost:8000
PUBLIC_URL=http://localhost:3000

# استعادة كلمة المرور (SMTP) — مطلوب على Railway للإرسال الفعلي
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=ريالي <your@gmail.com>
# SMTP_USE_TLS=1
